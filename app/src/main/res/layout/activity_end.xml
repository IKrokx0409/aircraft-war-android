<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="@color/color_background">

    <!-- 游戏结束标题 -->
    <TextView
        android:id="@+id/tv_game_over"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:text="游戏结束"
        android:textColor="@color/color_title"
        android:textSize="48sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <!-- 显示得分 -->
    <TextView
        android:id="@+id/tv_score"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="最终得分：0"
        android:textSize="32sp"
        android:textColor="@color/color_accent_gold"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_opponent_score"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="对手得分：0"
        android:textSize="28sp"
        android:textColor="@color/color_text_secondary"
        android:gravity="center"
        android:layout_marginBottom="50dp"
        android:visibility="gone" />

    <!-- 查看排行榜按钮 -->
    <Button
        android:id="@+id/btn_ranking"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="查看排行榜"
        android:textSize="20sp"
        android:textColor="@color/color_button_text"
        android:layout_margin="10dp"
        app:strokeColor="@color/color_button_stroke"
        app:strokeWidth="1.5dp"
        app:cornerRadius="12dp" />

    <!-- 重新开始按钮 -->
    <Button
        android:id="@+id/btn_restart"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="重新开始"
        android:textSize="20sp"
        android:textColor="@color/color_button_text"
        android:layout_margin="10dp"
        app:strokeColor="@color/color_button_stroke"
        app:strokeWidth="1.5dp"
        app:cornerRadius="12dp" />

    <!-- 返回主菜单按钮 -->
    <Button
        android:id="@+id/btn_main_menu"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="返回主菜单"
        android:textSize="20sp"
        android:textColor="@color/color_text_primary"
        android:layout_margin="10dp"
        app:strokeColor="@color/color_button_back"
        app:strokeWidth="1dp"
        app:cornerRadius="12dp" />

    <!-- 退出游戏按钮 -->
    <Button
        android:id="@+id/btn_exit"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="退出游戏"
        android:textSize="20sp"
        android:textColor="@color/color_text_primary"
        android:layout_margin="10dp"
        app:strokeColor="@color/color_button_back"
        app:strokeWidth="1dp"
        app:cornerRadius="12dp" />

</LinearLayout>
