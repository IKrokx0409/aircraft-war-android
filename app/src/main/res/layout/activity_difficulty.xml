<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/color_background">

    <!-- 标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择难度"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="@color/color_title"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:layout_marginBottom="16dp" />

    <!-- 游戏模式提示 -->
    <TextView
        android:id="@+id/tv_mode_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="单机模式"
        android:textSize="16sp"
        android:textColor="@color/color_text_secondary"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <!-- Easy 按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_easy"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="简单 (Easy)"
            android:textSize="20sp"
            android:textColor="@color/color_easy"
            app:strokeColor="@color/color_easy"
            app:strokeWidth="2dp"
            app:cornerRadius="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="无 Boss 出现，适合新手"
            android:textSize="13sp"
            android:textColor="@color/color_text_secondary"
            android:gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Normal 按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_normal"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="普通 (Normal)"
            android:textSize="20sp"
            android:textColor="@color/color_normal"
            app:strokeColor="@color/color_normal"
            app:strokeWidth="2dp"
            app:cornerRadius="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="标准难度，会出现Boss"
            android:textSize="13sp"
            android:textColor="@color/color_text_secondary"
            android:gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Hard 按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="40dp">

        <Button
            android:id="@+id/btn_hard"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="困难 (Hard)"
            android:textSize="20sp"
            android:textColor="@color/color_hard"
            app:strokeColor="@color/color_hard"
            app:strokeWidth="2dp"
            app:cornerRadius="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="基础难度较高，且游戏难度随时间上升"
            android:textSize="13sp"
            android:textColor="@color/color_text_secondary"
            android:gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- 返回按钮 -->
    <Button
        android:id="@+id/btn_back"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="返回"
        android:textSize="16sp"
        android:textColor="@color/color_text_primary"
        android:paddingHorizontal="32dp"
        app:strokeColor="@color/color_button_back"
        app:strokeWidth="1dp"
        app:cornerRadius="10dp" />

</LinearLayout>
